# ==============================================================================
# REFSTUDIO - Configurazione Ambiente & Credenziali API
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE (PostgreSQL, Network Sync & Realtime)
# Crea un progetto gratuito su https://supabase.com
# Trovi URL e Anon Key in: Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opzionale: Service role key per migrazioni CLI o script server-side
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI
# Per Pre-match Briefing, Reportistica Tattica e Analisi Disciplinare
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# SICUREZZA AMMINISTRATORE
# Codice PIN Riservato (Default: 280899)
# ------------------------------------------------------------------------------
ADMIN_PIN_SECRET=280899

# ------------------------------------------------------------------------------
# FIREBASE STORAGE (Opzionale / Legacy per allegati file pesanti)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=refstudio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=refstudio-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=refstudio.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
